# Isla de IA de Rally Studio — variables de entorno.
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.
#
# Motor de IA (proveedor compatible con OpenAI: OpenRouter, DeepSeek, etc.)
# RALLY_AI_URL=https://api.tu-proveedor.com/v1
# RALLY_AI_KEY=sk-...
# RALLY_AI_MODEL=deepseek-v4.1-flash
#
# Claves de respaldo (CSV). Si la principal da 401/403/429, se prueba la siguiente.
# RALLY_AI_KEYS=sk-respaldo-1,sk-respaldo-2
#
# Modelo con visión (analiza el logo del equipo):
# RALLY_VISION_MODEL=deepseek-v4-flash-vision-exp
#
# Límite de uso de la isla (protege la cuota compartida):
# RALLY_AI_RATE_LIMIT=60          peticiones de IA por IP y por ventana (0 = sin límite)
# RALLY_AI_RATE_WINDOW=3600       segundos de la ventana (1 hora por defecto)
# RALLY_AI_USER_RATE_LIMIT=24     por USUARIO (header X-Rally-Actor de los chips de presencia; 0 = sin limite)
#
# Puerto del servicio:
# RALLY_SERVICE_PORT=8080
#
# CORS: dominios de las páginas publicadas, separados por coma.
# Vacío = solo mismo origen y localhost.
# RALLY_ALLOWED_ORIGINS=https://equipo.github.io,https://otro.netlify.app
#
# Token del puente de sincronización de archivos (Fase 2.1, scripts/sincronizar_nube.py).
# Si está vacío, solo 127.0.0.1 puede sincronizar (modo local). En la isla publica, NUNCA lo dejes vacío.
# RALLY_SYNC_TOKEN=cambia-esto-por-una-larga-al-azar
#
# URL de la isla que el frontend publica en build time:
# RALLY_AI_BASE_URL=https://rally-ia-isla.onrender.com
